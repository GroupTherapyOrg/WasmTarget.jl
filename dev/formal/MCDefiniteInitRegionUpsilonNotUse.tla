---------------------------- MODULE MCDefiniteInitRegionUpsilonNotUse ----------------------------
(* An upsilon carrying the subject to a handler not read as a use (UpsilonIsUse = FALSE). *)
EXTENDS DefiniteInit
MCN == 4
MCMeet == "Intersect"
MCCatchEdge == TRUE
MCUpsilonIsUse == FALSE
MCTrailingOnly == TRUE
MCExt == TRUE
=============================================================================
