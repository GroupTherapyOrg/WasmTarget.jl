#!/usr/bin/env bash
# a push to the march branch is a landing, and a landing is judged by origin's dev/ship.sh (dab5842d): only a ship.sh
# that carries today's rules sets WT_SHIP_RULES, so a lane or a stale autoship loop running an older copy (one without
# the hold, the retry cap or the progress row) is refused here, where every worktree's push passes, old copies included
# (the common dir's hooks are shared by every worktree; march-monitor-a, 19:56, D6). Install with
# cp dev/hooks/pre-push "$(git rev-parse --git-common-dir)/hooks/"
while read -r _local _lsha remote _rsha; do
  case "$remote" in
    refs/heads/wt2)
      want=$(git rev-parse "origin/wt2:dev/ship.sh" 2>/dev/null)
      if [ -z "$want" ] || [ "${WT_SHIP_RULES:-}" != "$want" ]; then
        echo "pre-push: REFUSED — a push to wt2 comes only from origin/wt2's own dev/ship.sh (its blob $want), not ${WT_SHIP_RULES:-a plain push}: rebase onto origin/wt2 and ship again" >&2
        exit 1
      fi ;;
  esac
done
exit 0
