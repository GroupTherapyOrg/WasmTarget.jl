#!/bin/sh
# Commit messages describe the change for humans. Transcript links, tool
# footers and agent-directed text never enter the history of this repo.
# Install (shared by every worktree): cp dev/hooks/commit-msg "$(git rev-parse --git-common-dir)/hooks/"
# CI enforces the same rule on the PR range and body (ci.yml, job `message-hygiene`).
msg="$1"
tmp="$msg.hygiene"
grep -v -E '^Claude-Session:|claude\.ai/code/session|Generated with \[?Claude Code' "$msg" > "$tmp"
# drop trailing blank lines left behind
awk '{ lines[NR] = $0 } END { n = NR; while (n > 0 && lines[n] ~ /^[[:space:]]*$/) n--; for (i = 1; i <= n; i++) print lines[i] }' "$tmp" > "$msg"
rm -f "$tmp"
# dev/CHARTER.md rule 3: every commit names the clause(s) it advances.
# A lander replaying agent commits states the clause for them: CHARTER="C1" git cherry-pick …
if [ -n "${CHARTER:-}" ] && ! grep -qE '^Charter: C[0-9]+' "$msg"; then
    printf '\nCharter: %s\n' "$CHARTER" >> "$msg"
fi
if ! grep -qE '^Charter: C[0-9]+' "$msg"; then
    echo "commit refused: add a 'Charter: C<n> …' trailer naming the dev/CHARTER.md clause(s) this change advances" >&2
    exit 1
fi
# the subject says what the change does, `<kind>(<scope>): <what>` as every landed commit does; a placeholder
# subject (wip, tmp, fixup, squash) tells the history nothing (2e9ead2f landed as "wip", 2026-10-29)
subject=$(sed -n '/^[[:space:]]*$/!{p;q;}' "$msg")
if printf '%s' "$subject" | grep -qiE '^(wip|tmp|temp|fixup!?|squash!?|todo|xxx)([[:space:]:]|$)' ||
   ! printf '%s' "$subject" | grep -qE '^(revert|[a-z]+)(\([^)]+\))?: .{12,}'; then
    echo "commit refused: the subject must say what the change does, '<kind>(<scope>): <what>', not \"$subject\"" >&2
    exit 1
fi
# one attribution: a message carries at most one Co-Authored-By trailer, indented or not (A35E4)
coauthors=$(grep -ciE '^[[:space:]]*Co-Authored-By:' "$msg" || true)
if [ "$coauthors" -gt 1 ]; then
    echo "commit refused: $coauthors Co-Authored-By trailers; a commit carries one" >&2
    exit 1
fi
# a `Closes: C<n>` line runs the full matrix (gate.yml: large-scale runs only when a full clause is
# closed out, Dale 2026-10-21): only on a tree whose ratchet reads C<n> CLOSED (the working tree the
# commit is made from)
closes=$(sed -n 's/^Closes: \(C[0-9][0-9]*\)$/\1/p' "$msg")
if [ -n "$closes" ]; then
    status=$(julia --startup-file=no -O0 --project=. test/parity_ratchet.jl 2>&1 || true)
    for c in $closes; do
        printf '%s\n' "$status" | grep -qE "^$c +.* CLOSED( |$)" ||
            { echo "commit refused: 'Closes: $c', but the ratchet does not read $c CLOSED on this tree" >&2; exit 1; }
    done
fi
